# Generate a unique token with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-output-from-openssl-rand-hex-32
BIND=127.0.0.1:3001
DATABASE_PATH=data/panpops.sqlite3
FRONTEND_DIR=../dist

# Leave empty when the frontend is served by this Rust server.
FRONTEND_ORIGIN=

# Obtain these in Razorpay Dashboard Test Mode first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A separate secret chosen when configuring the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=
