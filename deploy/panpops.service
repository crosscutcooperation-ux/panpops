[Unit]
Description=PanPops storefront and commerce API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=panpops
Group=panpops
WorkingDirectory=/var/www/panpops/current/backend
EnvironmentFile=/etc/panpops.env
ExecStart=/var/www/panpops/current/backend/panpops-server
Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/panpops
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
